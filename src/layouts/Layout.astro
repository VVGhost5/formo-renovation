---
import '../assets/sass/main.scss'
// FA subset: https://docs.fontawesome.com/web/setup/host-yourself/cssjs
import '@fortawesome/fontawesome-free/css/fontawesome.min.css'
import '@fortawesome/fontawesome-free/css/solid.min.css'
import '@fortawesome/fontawesome-free/css/regular.min.css'
import '@fortawesome/fontawesome-free/css/brands.min.css'
import '@fontsource/roboto/latin-300.css'
import '@fontsource/roboto/latin-400.css'
import '@fontsource/roboto/latin-500.css'
import '@fontsource/roboto/latin-700.css'
import '@fontsource/roboto-mono/latin-300.css'
import '@fontsource/roboto-mono/latin-400.css'
import '@fontsource/roboto-mono/latin-500.css'

interface Props {
  title?: string
  description?: string
  jsonLd?: object
}

const {
  title       = 'Formo Renovations — Design & Renovation Solutions',
  description = 'Premium renovation and interior finishing solutions for homes across Victoria and Vancouver Island, BC.',
  jsonLd,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="M3iITSQj25uxNNbwiAyWq9oB7pUy9qkNuN4wRE6oDVM" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HPTRQ67KC8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18500972696');
      gtag('config', 'G-HPTRQ67KC8');
    </script>
  </head>
  <body>
    <slot />
    <script>
      function elementForHash(hash: string) {
        const raw = decodeURIComponent(hash.replace(/^#/, ''))
        if (!raw) return null
        const id = raw.replace(/\/+$/, '')
        return document.getElementById(id) || document.getElementById(raw)
      }

      function scrollToHash(hash: string) {
        const target = elementForHash(hash)
        if (!target) return false
        target.scrollIntoView({ behavior: 'smooth', block: 'start' })
        return true
      }

      document.querySelectorAll<HTMLElement>('[data-scroll-target]').forEach((el) => {
        el.addEventListener('click', () => {
          const id = el.dataset.scrollTarget
          if (!id) return
          scrollToHash(`#${id}`)
        })
      })

      document.addEventListener('click', (event) => {
        if (event.defaultPrevented) return
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return
        const link = (event.target as Element | null)?.closest('a[href]')
        if (!link || link.hasAttribute('download')) return
        const href = link.getAttribute('href')
        if (!href || href === '#') return
        let url: URL
        try {
          url = new URL(href, window.location.href)
        } catch {
          return
        }
        if (!url.hash || url.origin !== window.location.origin || url.pathname !== window.location.pathname) return
        if (!elementForHash(url.hash)) return
        event.preventDefault()
        if (window.location.hash !== url.hash) history.pushState(null, '', url.hash)
        scrollToHash(url.hash)
      })

      if (location.hash) requestAnimationFrame(() => scrollToHash(location.hash))
    </script>
  </body>
</html>
