---
import '../assets/sass/main.scss'
// FA subset: https://docs.fontawesome.com/web/setup/host-yourself/cssjs
import '@fortawesome/fontawesome-free/css/fontawesome.min.css'
import '@fortawesome/fontawesome-free/css/solid.min.css'
import '@fortawesome/fontawesome-free/css/regular.min.css'
import '@fortawesome/fontawesome-free/css/brands.min.css'
import '@fontsource/roboto/latin-300.css'
import '@fontsource/roboto/latin-400.css'
import '@fontsource/roboto/latin-500.css'
import '@fontsource/roboto/latin-700.css'
import '@fontsource/roboto-mono/latin-300.css'
import '@fontsource/roboto-mono/latin-400.css'
import '@fontsource/roboto-mono/latin-500.css'

interface Props {
  title?: string
  description?: string
  jsonLd?: object
}

const {
  title       = 'Formo Renovations — Design & Renovation Solutions',
  description = 'Premium renovation and interior finishing solutions for homes across Victoria and Vancouver Island, BC.',
  jsonLd,
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="M3iITSQj25uxNNbwiAyWq9oB7pUy9qkNuN4wRE6oDVM" />
    <title>{title}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HPTRQ67KC8"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    
      gtag('config', 'G-HPTRQ67KC8');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
