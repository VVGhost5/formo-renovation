---
import Layout        from '../layouts/Layout.astro'
import TheNav        from '../components/vue/TheNav.vue'
import SectionNumbers from '../components/SectionNumbers.astro'
import SectionContact from '../components/SectionContact.astro'
import TheFooter     from '../components/TheFooter.astro'
import {
	getAboutPage,
	getSiteSettings,
	getHomeContact,
	getHomeNumbers,
	getPageMetadata,
	DEFAULT_ABOUT_PAGE,
	DEFAULT_SITE_SETTINGS,
	DEFAULT_HOME_CONTACT,
	DEFAULT_HOME_NUMBERS,
	DEFAULT_PAGE_SEO,
} from '../utils/sanity'
import {bgStyle} from '../utils/sanity/backgrounds'

let page = DEFAULT_ABOUT_PAGE
let site = DEFAULT_SITE_SETTINGS
let contact = DEFAULT_HOME_CONTACT
let numbers = DEFAULT_HOME_NUMBERS
let pageMeta = DEFAULT_PAGE_SEO.aboutUs

try {
	;[page, site, contact, numbers, pageMeta] = await Promise.all([
		getAboutPage(),
		getSiteSettings(),
		getHomeContact(),
		getHomeNumbers(),
		getPageMetadata('aboutUs'),
	])
} catch (err) {
	console.warn('[sanity] About page fallback.', err)
}

const heroBg = bgStyle(page.heroImageUrl)
const valuesBg = bgStyle(page.valuesHeroBackgroundUrl)
const whyBg = bgStyle(page.whyBannerBackgroundUrl)

const storyCta = /our story/i.test(page.primaryCtaLabel) || page.primaryCtaLink === '#our-story'
const showPrimaryCta = Boolean(page.primaryCtaLabel) && !(storyCta && !page.storyIsShowed)

let pageJsonLd: object | undefined
if (pageMeta.jsonLd) {
	try { pageJsonLd = JSON.parse(pageMeta.jsonLd) } catch {}
}
---

<Layout
  title="About Formo Renovations — Our Story, Team & Values"
  description="Learn the story behind Formo Renovations — our team, values, and commitment to quality craftsmanship across Victoria and Vancouver Island, BC since 2016."
  jsonLd={pageJsonLd}
>
  <TheNav client:load page="about-us" phone={site.phone} email={site.email} phoneHours={site.phoneHours} officeWeekdayHours={site.officeWeekdayHours} emailNote={site.emailNote} />

  {page.heroIsShowed && (
  <section id="hero" class:list={['about-page-hero', !page.founderCardIsShowed && 'no-side-card']}>
    <div class="hero-bg-img" style={heroBg} aria-hidden="true"></div>

    <div class="hero-content">
      <div class="hero-left">
        <div class="hero-eyebrow">
          <span class="hero-eyebrow-dot"></span>
          {page.locationLabel}
        </div>
        <h1 class="hero-h1">
          {page.titleBefore}
          <em>{page.titleEmphasis}</em>
        </h1>
        <hr class="hero-line" />
        <p class="hero-desc">{page.description}</p>
        <div class="hero-actions">
          {showPrimaryCta && (
            <a href={page.primaryCtaLink} class="btn-dark">{page.primaryCtaLabel}</a>
          )}
          {page.secondaryCtaLabel && (
            <a href={page.secondaryCtaLink} class="btn-outline">{page.secondaryCtaLabel}</a>
          )}
        </div>
      </div>

      {page.founderCardIsShowed && (
        <div class="hero-founder-card">
          <div>
            <div class="hero-founder-photo">{page.founderInitial}</div>
          </div>
          <div>
            <div class="hero-founder-name">{page.founderName}</div>
            <div class="hero-founder-role">{page.founderRole}</div>
          </div>
          <p class="hero-founder-quote">{page.founderQuote}</p>
          <div class="hero-founder-stats">
            {page.founderStats.map((stat) => (
              <div class="hfs-cell">
                <div class="hfs-val">
                  {stat.value}{stat.suffix ? <sup>{stat.suffix}</sup> : null}
                </div>
                <div class="hfs-label">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
  )}

  {page.whoIsShowed && (
  <section id="who-we-are">
    <div class="who-grid">
      <div class="who-left">
        <span class="eyebrow-light">{page.whoEyebrow}</span>
        <h2 class="who-headline">
          {page.whoHeadline}
          <em>{page.whoHeadlineEmphasis}</em>
        </h2>
      </div>
      <div class="who-right">
        <p class="who-lead">{page.whoLead}</p>
        {page.whoBody.map((para) => (
          <p class="who-body">{para}</p>
        ))}
        <div class="who-pills">
          {page.whoPills.map((pill) => (
            <span class="who-pill">{pill}</span>
          ))}
        </div>
        <a href={page.whoCtaLink} class="btn-dark" style="width:fit-content;">{page.whoCtaLabel}</a>
      </div>
    </div>
  </section>
  )}

  {numbers.isShowed && <SectionNumbers content={numbers} />}

  {page.storyIsShowed && (
  <section id="our-story">
    <div class="story-head">
      <div>
        <span class="eyebrow-light">{page.storyEyebrow}</span>
        <h2 class="story-headline">
          {page.storyHeadline}
          <em>{page.storyHeadlineEmphasis}</em>
        </h2>
      </div>
      <p class="story-lead">{page.storyLead}</p>
    </div>

    <div class="timeline">
      {page.timeline.map((item) => (
        <div class={`tl-item${item.highlight ? ' highlight' : ''}`}>
          <div class="tl-dot"></div>
          <div class="tl-year">{item.year}</div>
          <div class="tl-body">
            <div class="tl-title">{item.title}</div>
            <p class="tl-text">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
  )}

  {page.valuesIsShowed && (
  <section id="our-values">
    <div class="values-hero">
      <div class="values-hero-img" style={valuesBg}></div>
      <div class="values-hero-content">
        <span class="eyebrow-dark">{page.valuesEyebrow}</span>
        <h2 class="values-headline">
          {page.valuesHeadline}
          <em>{page.valuesHeadlineEmphasis}</em>
        </h2>
        <p class="values-desc">{page.valuesDescription}</p>
      </div>
    </div>

    <div class="values-grid">
      {page.valueCards.map((card, i) => (
        <div class="val-card">
          <div class="val-icon"><i class={card.icon}></i></div>
          <div class="val-num">{String(i + 1).padStart(2, '0')}</div>
          <div class="val-title">{card.title}</div>
          <p class="val-body">{card.body}</p>
        </div>
      ))}
    </div>
  </section>
  )}

  {page.teamIsShowed && (
  <section id="our-team">
    <div class="team-head">
      <div>
        <span class="eyebrow-light">{page.teamEyebrow}</span>
        <h2 class="team-headline">
          {page.teamHeadline}
          <em>{page.teamHeadlineEmphasis}</em>
        </h2>
      </div>
      <p class="team-desc">{page.teamDescription}</p>
    </div>

    <div class="team-grid">
      {page.teamMembers.map((member) => (
        <div class="team-card">
          {member.photoUrl && (
            <img width="309" height="412" class="team-photo" src={member.photoUrl} alt={member.name} loading="lazy" />
          )}
          <div class="team-card-body">
            <div class="team-card-name">{member.name}</div>
            <div class="team-card-role">{member.role}</div>
            <p class="team-card-bio">{member.bio}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
  )}

  {page.whyIsShowed && (
  <section id="why-us">
    <div class="why-banner">
      <div class="why-banner-img" style={whyBg}></div>
      <div class="why-banner-content">
        <span class="eyebrow-dark">{page.whyEyebrow}</span>
        <h2 class="why-banner-headline">{page.whyBannerHeadline} <em>{page.whyBannerHeadlineEmphasis}</em></h2>
        <p class="why-banner-desc">{page.whyBannerDescription}</p>
      </div>
    </div>

    <div class="why-rows">
      {page.whyRows.map((row, i) => (
        <div class={`why-row${i % 2 !== 0 ? ' alt' : ''}`}>
          <div class="why-row-img">
            {row.imageUrl && (
              <img width="720" height="426" src={row.imageUrl} alt={row.imageAlt} loading="lazy" />
            )}
          </div>
          <div class="why-row-text">
            <div class="why-row-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="mono-label">{row.label}</div>
            <h3 class="why-row-title">{row.title}</h3>
            <p class="why-row-body">{row.body}</p>
            <div class="why-row-pills">
              {row.pills.map((pill) => (
                <span class="why-pill">{pill}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
  )}

  {page.certIsShowed && (
  <section id="certifications">
    <div class="cert-inner">
      <div class="cert-left">
        <span class="eyebrow-light">{page.certEyebrow}</span>
        <h2 class="cert-headline">{page.certHeadline} <em>{page.certHeadlineEmphasis}</em></h2>
        <p class="cert-desc">{page.certDescription}</p>
      </div>
      <div class="cert-badges">
        {page.certBadges.map((badge) => (
          <div class="cert-badge">
            <div class="cert-badge-icon"><i class={badge.icon}></i></div>
            <div class="cert-badge-name">{badge.name}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="guarantee-grid">
      {page.guaranteeCards.map((card) => (
        <div class="guar-card">
          <div class="guar-icon"><i class={card.icon}></i></div>
          <div class="guar-body">
            <div class="guar-title">{card.title}</div>
            <p class="guar-text">{card.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
  )}

  <SectionContact content={contact} site={site} />
  <TheFooter site={site} />

</Layout>
