---
import Layout        from '../layouts/Layout.astro'
import TheNav        from '../components/vue/TheNav.vue'
import SectionContact from '../components/SectionContact.astro'
import TheFooter     from '../components/TheFooter.astro'
import {
	getServicesPage,
	getServicesList,
	getSiteSettings,
	getHomeContact,
	getPageMetadata,
	DEFAULT_SERVICES_PAGE,
	DEFAULT_SERVICES,
	DEFAULT_SITE_SETTINGS,
	DEFAULT_HOME_CONTACT,
	DEFAULT_PAGE_SEO,
} from '../utils/sanity'
import {bgStyle} from '../utils/sanity/backgrounds'

let page = DEFAULT_SERVICES_PAGE
let services = DEFAULT_SERVICES
let site = DEFAULT_SITE_SETTINGS
let contact = DEFAULT_HOME_CONTACT
let pageMeta = DEFAULT_PAGE_SEO.services

try {
	;[page, services, site, contact, pageMeta] = await Promise.all([
		getServicesPage(),
		getServicesList(),
		getSiteSettings(),
		getHomeContact(),
		getPageMetadata('services'),
	])
} catch (err) {
	console.warn('[sanity] Services page fallback.', err)
}

const heroBg = bgStyle(page.heroImageUrl)
const processBg = bgStyle(page.processHeroBackgroundUrl)

let pageJsonLd: object | undefined
if (pageMeta.jsonLd) {
	try { pageJsonLd = JSON.parse(pageMeta.jsonLd) } catch {}
}
---

<Layout
  title="Our Services — Formo Renovations"
  description="Full-range renovation and interior finishing services for Victoria and Vancouver Island — bathrooms, kitchens, flooring, full home renovations, and more."
  jsonLd={pageJsonLd}
>
  <TheNav client:load page="services" phone={site.phone} email={site.email} phoneHours={site.phoneHours} officeWeekdayHours={site.officeWeekdayHours} emailNote={site.emailNote} />

  {page.heroIsShowed && (
  <section id="hero" class="svc-page-hero">
    <div class="hero-bg-img" style={heroBg} aria-hidden="true"></div>
    <div class="hero-content">

      <div class="hero-left">
        <div class="hero-eyebrow">
          <span class="hero-dot"></span>
          {page.locationLabel}
        </div>
        <h1 class="hero-h1">
          {page.titleBefore}
          <em>{page.titleEmphasis}</em>
        </h1>
        <hr class="hero-line" />
        <p class="hero-desc">{page.description}</p>
        <div class="hero-actions">
          <a href={page.primaryCtaLink} class="btn-dark">{page.primaryCtaLabel}</a>
          <a href={page.secondaryCtaLink} class="btn-outline">{page.secondaryCtaLabel}</a>
        </div>
      </div>

      <div class="hero-quick">
        <div class="hero-quick-label">Jump to a service</div>
        {services.map((svc) => (
          <a href={`#${svc.id}`} class="hero-quick-item">
            <div class="hqi-icon"><i class={svc.icon}></i></div>
            <div class="hqi-body">
              <div class="hqi-name">{svc.quickName}</div>
              <div class="hqi-sub">{svc.quickSub}</div>
            </div>
            <span class="hqi-arr">→</span>
          </a>
        ))}
      </div>

    </div>
  </section>
  )}

  {page.listIsShowed && (
  <>
  <section id="services-strip">
    <div class="strip-inner">
      {services.map((svc, i) => (
        <a href={`#${svc.id}`} class="strip-cell">
          <div class="sc-icon"><i class={svc.icon}></i></div>
          <div class="sc-name">{svc.stripName}</div>
          <div class="sc-count">Service {String(i + 1).padStart(2, '0')}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- ══ SERVICES LIST ══ -->
  <section id="services-list">
    {services.map((svc, i) => (
      <div class={`svc-block${i % 2 !== 0 ? ' flip' : ''}`} id={svc.id}>
        <div class="svc-img-col">
          {svc.imageUrl && (
            <img width="720" height="774" src={svc.imageUrl} alt={svc.imageAlt} loading="lazy" />
          )}
          <div class="svc-img-badge">
            <span class="svc-img-badge-icon"><i class={svc.icon}></i></span>
            <span class="svc-img-badge-text">{svc.eyebrow}</span>
          </div>
        </div>
        <div class="svc-text-col">
          <div class="svc-num">{String(i + 1).padStart(2, '0')}</div>
          <div class="svc-eyebrow">{svc.eyebrow}</div>
          <h2 class="svc-title">{svc.title}</h2>
          <p class="svc-lead">{svc.lead}</p>
          {svc.includes.length > 0 && (
            <>
              <div class="svc-includes-label">What's included</div>
              <ul class="svc-includes">
                {svc.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          )}
          {svc.meta.length > 0 && (
            <div class="svc-meta">
              {svc.meta.map((m) => (
                <div class="svc-meta-item">
                  <span class="svc-meta-key">{m.key}</span>
                  <span class="svc-meta-val">{m.val}</span>
                </div>
              ))}
            </div>
          )}
          <a href="#contact" class="svc-cta">Get a Quote for This Service →</a>
        </div>
      </div>
    ))}
  </section>
  </>
  )}

  {page.processIsShowed && (
  <section id="our-process">
    <div class="svc-process-hero">
      <div class="svc-process-hero-img" style={processBg}></div>
      <div class="svc-process-hero-content">
        <span class="svc-process-eyebrow">{page.processEyebrow}</span>
        <h2 class="svc-process-headline">{page.processHeadline} <em>{page.processHeadlineEmphasis}</em></h2>
        <p class="svc-process-sub">{page.processDescription}</p>
      </div>
    </div>

    <div class="process-steps">
      {page.processSteps.map((step, i) => (
        <div class="pstep">
          <div class="pstep-num">{String(i + 1).padStart(2, '0')}</div>
          <div class="pstep-icon"><i class={step.icon}></i></div>
          <div class="pstep-title">{step.title}</div>
          <p class="pstep-body">{step.body}</p>
        </div>
      ))}
    </div>
  </section>
  )}

  {page.pricingIsShowed && (
  <section id="pricing-hint">
    <div class="ph-inner">
      <div class="ph-left">
        <div class="ph-eyebrow">{page.pricingEyebrow}</div>
        <h2 class="ph-headline">
          {page.pricingHeadline}<br />
          <em>{page.pricingHeadlineEmphasis}</em>
        </h2>
        <p class="ph-body">{page.pricingBody}</p>
      </div>
    </div>
    <div class="ph-cards">
      {page.pricingCards.map((card) => (
        <div class="ph-card">
          <div class="ph-card-icon"><i class={card.icon}></i></div>
          <div class="ph-card-title">{card.title}</div>
          <p class="ph-card-body">{card.body}</p>
        </div>
      ))}
    </div>
  </section>
  )}

  {page.faqIsShowed && (
  <section id="faq">
    <div class="faq-grid">
      <div class="faq-left">
        <span class="faq-eyebrow">{page.faqEyebrow}</span>
        <h2 class="faq-title">{page.faqTitle} <em>{page.faqTitleEmphasis}</em></h2>
        <p class="faq-sub">{page.faqSub}</p>
      </div>

      <div class="faq-list">
        {page.faqItems.map((item) => (
          <div class="faq-item">
            <button class="faq-q">
              <span class="fq-text">{item.question}</span>
              <div class="fq-icon">+</div>
            </button>
            <div class="faq-a">
              <div class="faq-a-inner">{item.answer}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <SectionContact content={contact} site={site} />
  <TheFooter site={site} />

</Layout>

<script>
  // FAQ accordion
  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item') as HTMLElement;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  window.addEventListener('scroll', () => {
    const stripCells = document.querySelectorAll('.strip-cell');
    const serviceBlocks = document.querySelectorAll('.svc-block[id]');
    let activeIdx = 0;
    serviceBlocks.forEach((el, i) => {
      if (el instanceof HTMLElement && window.scrollY >= el.offsetTop - 120) activeIdx = i;
    });
    stripCells.forEach((c, i) => c.classList.toggle('active-strip', i === activeIdx));
  });
</script>
