---
import Layout             from '../layouts/Layout.astro'
import TheNav             from '../components/vue/TheNav.vue'
import SectionHero        from '../components/SectionHero.astro'
import SectionNumbers     from '../components/SectionNumbers.astro'
import SectionServices    from '../components/SectionServices.astro'
import SectionAbout       from '../components/SectionAbout.astro'
import SectionPortfolio   from '../components/SectionPortfolio.astro'
import SectionProcess     from '../components/SectionProcess.astro'
import SectionPricing     from '../components/SectionPricing.astro'
import BeforeAfterSlider  from '../components/vue/BeforeAfterSlider.vue'
import TestimonialsSlider from '../components/vue/TestimonialsSlider.vue'
import SectionContact     from '../components/SectionContact.astro'
import TheFooter          from '../components/TheFooter.astro'
import {
	getHomePageContent,
	getServicesPage,
	getPageMetadata,
	DEFAULT_HERO,
	DEFAULT_HOME_NUMBERS,
	DEFAULT_HOME_SERVICES,
	DEFAULT_HOME_ABOUT,
	DEFAULT_HOME_PORTFOLIO,
	DEFAULT_HOME_PROCESS,
	DEFAULT_HOME_PRICING,
	DEFAULT_HOME_CONTACT,
	DEFAULT_BEFORE_AFTER,
	DEFAULT_HOME_BEFORE_AFTER_BANNER,
	DEFAULT_SITE_SETTINGS,
	DEFAULT_SERVICES_PAGE,
	DEFAULT_PAGE_SEO,
} from '../utils/sanity'

let home = {
	hero: DEFAULT_HERO,
	numbers: DEFAULT_HOME_NUMBERS,
	services: DEFAULT_HOME_SERVICES,
	about: DEFAULT_HOME_ABOUT,
	portfolio: DEFAULT_HOME_PORTFOLIO,
	process: DEFAULT_HOME_PROCESS,
	pricing: DEFAULT_HOME_PRICING,
	contact: DEFAULT_HOME_CONTACT,
	testimonials: [],
	beforeAfter: DEFAULT_BEFORE_AFTER,
	beforeAfterBanner: DEFAULT_HOME_BEFORE_AFTER_BANNER,
	site: DEFAULT_SITE_SETTINGS,
}

try {
	home = await getHomePageContent()
} catch (err) {
	console.warn('[sanity] Could not load homepage content, using defaults.', err)
}

let faqItems = DEFAULT_SERVICES_PAGE.faqItems
try {
	const servicesData = await getServicesPage()
	faqItems = servicesData.faqItems
} catch {
	// use defaults
}

const SITE_URL = 'https://formorenovations.com'

const sameAsUrls = [
	home.site.instagramUrl,
	home.site.facebookUrl,
	home.site.houzzUrl,
	home.site.homestarsUrl,
].filter((url) => url && url !== '#')

const autoJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${SITE_URL}/#website`,
			name: 'Formo Renovations',
			url: `${SITE_URL}/`,
			description:
				'Premium renovation and interior finishing solutions for homes across Victoria and Vancouver Island, BC.',
			inLanguage: 'en-CA',
			potentialAction: {
				'@type': 'SearchAction',
				target: {
					'@type': 'EntryPoint',
					urlTemplate: `${SITE_URL}/?q={search_term_string}`,
				},
				'query-input': 'required name=search_term_string',
			},
		},
		{
			'@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
			'@id': `${SITE_URL}/#business`,
			name: 'Formo Renovations',
			url: `${SITE_URL}/`,
			logo: {
				'@type': 'ImageObject',
				'@id': `${SITE_URL}/#logo`,
				url: `${SITE_URL}/logo.png`,
				contentUrl: `${SITE_URL}/logo.png`,
				caption: 'Formo Renovations',
			},
			image: `${SITE_URL}/logo.png`,
			description: home.site.footerDescription,
			telephone: home.site.phone,
			email: home.site.email,
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'PLACEHOLDER_STREET_ADDRESS',
				addressLocality: 'Victoria',
				addressRegion: 'BC',
				postalCode: 'PLACEHOLDER_POSTAL_CODE',
				addressCountry: 'CA',
			},
			geo: {
				'@type': 'GeoCoordinates',
				latitude: 48.4284,
				longitude: -123.3656,
			},
			areaServed: [
				{
					'@type': 'City',
					name: 'Victoria',
					sameAs: 'https://en.wikipedia.org/wiki/Victoria,_British_Columbia',
				},
				{
					'@type': 'AdministrativeArea',
					name: 'Vancouver Island',
				},
			],
			openingHoursSpecification: [
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
					opens: '08:00',
					closes: '17:00',
				},
			],
			priceRange: '$$',
			foundingDate: '2016',
			founder: {
				'@type': 'Person',
				name: 'Michael Formo',
			},
			contactPoint: {
				'@type': 'ContactPoint',
				telephone: home.site.phone,
				email: home.site.email,
				contactType: 'customer service',
				areaServed: 'CA',
				availableLanguage: 'en',
				hoursAvailable: {
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
					opens: '08:00',
					closes: '17:00',
				},
			},
			...(sameAsUrls.length > 0 && {sameAs: sameAsUrls}),
		},
		{
			'@type': 'FAQPage',
			mainEntity: faqItems.map((item) => ({
				'@type': 'Question',
				name: item.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.answer,
				},
			})),
		},
	],
}

let pageMeta = DEFAULT_PAGE_SEO.home
try {
	pageMeta = await getPageMetadata('home')
} catch {}

let homepageJsonLd: object = autoJsonLd
if (pageMeta.jsonLd) {
	try {
		homepageJsonLd = JSON.parse(pageMeta.jsonLd)
	} catch {
		console.warn('[structured-data] Invalid JSON in metaData.home.jsonLd, using auto-generated schema.')
	}
}
---

<Layout title="Formo Renovations — Design & Renovation Solutions" jsonLd={homepageJsonLd}>
  <TheNav client:load page="home" phone={home.site.phone} email={home.site.email} phoneHours={home.site.phoneHours} officeWeekdayHours={home.site.officeWeekdayHours} emailNote={home.site.emailNote} />

  {home.hero.isShowed && <SectionHero hero={home.hero} />}
  {home.numbers.isShowed && <SectionNumbers content={home.numbers} />}
  {home.services.isShowed && <SectionServices content={home.services} />}
  {home.about.isShowed && <SectionAbout content={home.about} />}
  {home.portfolio.isShowed && <SectionPortfolio content={home.portfolio} />}
  {home.process.isShowed && <SectionProcess content={home.process} />}
  {home.pricing.isShowed && <SectionPricing content={home.pricing} />}
  {home.beforeAfterBanner.isShowed && <BeforeAfterSlider client:visible items={home.beforeAfter} banner={home.beforeAfterBanner} />}
  {home.site.testimonialsIsShowed && (
    <TestimonialsSlider
      client:visible
      items={home.testimonials}
      backgroundUrl={home.site.testimonialsBackgroundUrl}
    />
  )}
  {home.contact.isShowed && <SectionContact content={home.contact} site={home.site} />}
  <TheFooter site={home.site} />
</Layout>
