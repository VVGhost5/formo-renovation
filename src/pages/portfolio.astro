---
import Layout          from '../layouts/Layout.astro'
import TheNav          from '../components/vue/TheNav.vue'
import PortfolioWorks  from '../components/vue/PortfolioWorks.vue'
import SectionContact  from '../components/SectionContact.astro'
import TheFooter       from '../components/TheFooter.astro'
import {
	getPortfolioPage,
	getPortfolioProjects,
	getSiteSettings,
	getHomeContact,
	getPageMetadata,
	DEFAULT_PORTFOLIO_PAGE,
	DEFAULT_SITE_SETTINGS,
	DEFAULT_HOME_CONTACT,
	DEFAULT_PAGE_SEO,
} from '../utils/sanity'
import {bgStyle} from '../utils/sanity/backgrounds'

let page = DEFAULT_PORTFOLIO_PAGE
let projects: Awaited<ReturnType<typeof getPortfolioProjects>> = []
let site = DEFAULT_SITE_SETTINGS
let contact = DEFAULT_HOME_CONTACT
let pageMeta = DEFAULT_PAGE_SEO.portfolio

try {
	;[page, projects, site, contact, pageMeta] = await Promise.all([
		getPortfolioPage(),
		getPortfolioProjects(),
		getSiteSettings(),
		getHomeContact(),
		getPageMetadata('portfolio'),
	])
} catch (err) {
	console.warn('[sanity] Portfolio page fallback.', err)
}

const heroBg = bgStyle(page.heroImageUrl)

let pageJsonLd: object | undefined
if (pageMeta.jsonLd) {
	try { pageJsonLd = JSON.parse(pageMeta.jsonLd) } catch {}
}
---

<Layout
  title="Portfolio — Formo Renovations"
  description="Browse our completed renovation projects across Victoria and Vancouver Island, BC — kitchens, bathrooms, living rooms, and full apartment transformations."
  jsonLd={pageJsonLd}
>
  <TheNav client:load page="portfolio" phone={site.phone} email={site.email} phoneHours={site.phoneHours} officeWeekdayHours={site.officeWeekdayHours} emailNote={site.emailNote} />

  <section id="hero" class="portfolio-hero-page">
    <div class="hero-bg-img" style={heroBg}></div>

    <div class="port-hero-content">
      <div>
        <div class="port-hero-eyebrow">
          <span class="port-hero-eyebrow-dot"></span>
          {page.locationLabel}
        </div>

        <h1 class="port-hero-h1">
          {page.titleBefore}
          <em>{page.titleEmphasis}</em>
        </h1>

        <hr class="port-hero-line" />

        <p class="port-hero-desc">{page.description}</p>

        <div class="port-hero-actions">
          {page.secondaryCtaLabel && (
            <a href={page.secondaryCtaLink || '#'} class="btn-outline">{page.secondaryCtaLabel}</a>
          )}
        </div>
      </div>
    </div>
  </section>

  <PortfolioWorks client:load projects={projects} />
  <SectionContact content={contact} site={site} />
  <TheFooter site={site} />
</Layout>
