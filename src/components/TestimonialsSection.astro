---
import type {TestimonialDoc} from '../utils/sanity'

interface Props {
	testimonials: TestimonialDoc[]
}

const {testimonials} = Astro.props
---

<section class="testimonials" aria-labelledby="testimonials-heading">
	<div class="testimonials__inner">
		<h2 id="testimonials-heading" class="testimonials__title">Testimonials</h2>
		{
			testimonials.length === 0 ? (
				<p class="testimonials__empty">
					No testimonials yet. Add <strong>Testimonial</strong> documents in Sanity Studio to list
					them here.
				</p>
			) : (
				<ul class="testimonials__list">
					{testimonials.map((t) => (
						<li class="testimonials__card">
							<p class="testimonials__quote">&ldquo;{t.quote}&rdquo;</p>
							<div class="testimonials__meta">
								<span class="testimonials__name">{t.name}</span>
								<span class="testimonials__stars" aria-hidden="true">
									{'★'.repeat(Math.min(5, Math.max(1, Math.round(t.rating))))}
								</span>
								<span class="testimonials__sr-rating">
									Rating: {Math.min(5, Math.max(1, Math.round(t.rating)))} out of 5
								</span>
							</div>
						</li>
					))}
				</ul>
			)
		}
	</div>
</section>

<style>
	.testimonials {
		padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 3rem);
		background: #fafaf9;
		color: #1c1917;
	}

	.testimonials__inner {
		max-width: 56rem;
		margin: 0 auto;
	}

	.testimonials__title {
		margin: 0 0 1.5rem;
		font-size: clamp(1.25rem, 2.5vw, 1.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.testimonials__empty {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: #57534e;
		max-width: 40ch;
	}

	.testimonials__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
	}

	.testimonials__card {
		margin: 0;
		padding: 1.25rem 1.35rem;
		background: #fff;
		border: 1px solid #e7e5e4;
		border-radius: 0.75rem;
		box-shadow: 0 1px 2px rgb(28 25 23 / 0.04);
	}

	.testimonials__quote {
		margin: 0 0 1rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: #292524;
	}

	.testimonials__meta {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		font-size: 0.875rem;
	}

	.testimonials__name {
		font-weight: 600;
		color: #1c1917;
	}

	.testimonials__stars {
		color: #ca8a04;
		letter-spacing: 0.05em;
		font-size: 0.9rem;
		line-height: 1;
	}

	.testimonials__sr-rating {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
