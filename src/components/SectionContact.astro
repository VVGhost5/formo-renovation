---
import type {HomeContactContent, SiteSettingsContent} from '../utils/sanity'

interface Props {
	content: HomeContactContent
	site: SiteSettingsContent
}

const {content, site} = Astro.props
const phoneHref = `tel:${site.phone.replace(/\D/g, '')}`
const waHref = `https://wa.me/${site.whatsapp.replace(/\D/g, '')}`
---
<section id="contact">
  <div class="contact-top">
    <div class="contact-photo-side">
      <img src={content.photoUrl} alt={content.photoAlt} loading="lazy" />
      <div class="contact-photo-overlay"></div>
      <div class="contact-photo-content">
        <div class="contact-eyebrow">{content.eyebrow}</div>
        <h2 class="contact-headline">
          {content.headline}<br />Your <em>{content.headlineEmphasis}</em>
        </h2>
        <p class="contact-lead">{content.lead}</p>
        <button class="btn-outline-light">{content.ctaLabel}</button>
      </div>
    </div>

    <div class="contact-form-side">
      <div class="contact-form-title">{content.formTitle}</div>
      <div class="contact-form-sub">{content.formSubtext}</div>

      <div class="cform">
        <div class="cform-row">
          <div class="fg">
            <label for="contact-first-name">First Name</label>
            <input id="contact-first-name" type="text" placeholder="John" />
          </div>
          <div class="fg">
            <label for="contact-last-name">Last Name</label>
            <input id="contact-last-name" type="text" placeholder="Smith" />
          </div>
        </div>
        <div class="fg">
          <label for="contact-email">Email</label>
          <input id="contact-email" type="email" placeholder="john@email.com" />
        </div>
        <div class="fg">
          <label for="contact-phone">Phone</label>
          <input id="contact-phone" type="tel" placeholder={site.phone} />
        </div>
        <div class="fg">
          <label for="contact-service">Service Interested In</label>
          <select id="contact-service">
            <option value="">Select a service…</option>
            <option>Interior Finishing</option>
            <option>Bathroom Renovations</option>
            <option>Kitchen Renovations</option>
            <option>Flooring</option>
            <option>Painting</option>
            <option>Project Management</option>
            <option>Free Estimate Only</option>
          </select>
        </div>
        <div class="fg">
          <label for="contact-message">Tell Us About Your Project</label>
          <textarea id="contact-message" placeholder="Describe your project, location, timeline and any relevant details…"></textarea>
        </div>
        <button class="cform-submit">Send Message →</button>
      </div>
    </div>
  </div>

  <div class="contact-info-bar">
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-solid fa-phone"></i></div>
      <div class="cinfo-label">Phone</div>
      <div class="cinfo-value"><a href={phoneHref}>{site.phone}</a></div>
      <div class="cinfo-note">{site.phoneHours}</div>
    </div>
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-solid fa-envelope"></i></div>
      <div class="cinfo-label">Email</div>
      <div class="cinfo-value"><a href={`mailto:${site.email}`}>{site.email}</a></div>
      <div class="cinfo-note">{site.emailNote}</div>
    </div>
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-brands fa-whatsapp"></i></div>
      <div class="cinfo-label">WhatsApp</div>
      <div class="cinfo-value"><a href={waHref}>{site.whatsapp}</a></div>
      <div class="cinfo-note">{site.whatsappNote}</div>
    </div>
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-solid fa-location-dot"></i></div>
      <div class="cinfo-label">Service Area</div>
      <div class="cinfo-value">{site.serviceArea}</div>
      <div class="cinfo-note">{site.serviceAreaNote}</div>
    </div>
  </div>
</section>
