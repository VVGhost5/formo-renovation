---
import type {HomeContactContent, SiteSettingsContent} from '../utils/sanity'

interface Props {
	content: HomeContactContent
	site: SiteSettingsContent
}

const {content, site} = Astro.props
const phoneHref = `tel:${site.phone.replace(/\D/g, '')}`
const waHref = `https://wa.me/${site.whatsapp.replace(/\D/g, '')}`
---
<section id="contact">
  <div class="contact-top">
    <div class="contact-photo-side">
      <img width="640" height="800" src={content.photoUrl} alt={content.photoAlt} loading="lazy" />
      <div class="contact-photo-overlay"></div>
      <div class="contact-photo-content">
        <div class="contact-eyebrow">{content.eyebrow}</div>
        <h2 class="contact-headline">
          {content.headline}<br />Your <em>{content.headlineEmphasis}</em>
        </h2>
        <p class="contact-lead">{content.lead}</p>
        <button class="btn-outline-light">{content.ctaLabel}</button>
      </div>
    </div>

    <div class="contact-form-side">
      <div class="contact-form-title">{content.formTitle}</div>
      <div class="contact-form-sub">{content.formSubtext}</div>

      <div class="sc-success" id="sc-success" style="display:none;padding:24px;background:#f9f6f1;border-radius:8px;text-align:center;">
        <div style="font-size:28px;margin-bottom:8px;">✓</div>
        <div style="font-weight:700;font-size:18px;margin-bottom:6px;">Message Sent!</div>
        <p style="color:#666;margin:0;">We'll be in touch within one business day.</p>
      </div>

      <form class="cform" id="section-contact-form" novalidate>
        <input type="hidden" name="formType" value="request-consultation" />
        <div class="cform-row">
          <div class="fg" data-field="firstName">
            <label for="sc-first-name">First Name *</label>
            <input id="sc-first-name" type="text" placeholder="John" autocomplete="given-name" />
          </div>
          <div class="fg">
            <label for="sc-last-name">Last Name</label>
            <input id="sc-last-name" type="text" placeholder="Smith" autocomplete="family-name" />
          </div>
        </div>
        <div class="fg" data-field="email">
          <label for="sc-email">Email *</label>
          <input id="sc-email" type="email" placeholder="john@email.com" autocomplete="email" />
        </div>
        <div class="fg" data-field="phone">
          <label for="sc-phone">Phone *</label>
          <input id="sc-phone" type="tel" placeholder={site.phone} autocomplete="tel" />
        </div>
        <div class="fg">
          <label for="sc-service">Service Interested In</label>
          <select id="sc-service">
            <option value="">Select a service…</option>
            <option>Interior Finishing</option>
            <option>Bathroom Renovations</option>
            <option>Kitchen Renovations</option>
            <option>Flooring</option>
            <option>Painting</option>
            <option>Project Management</option>
            <option>Free Estimate Only</option>
          </select>
        </div>
        <div class="fg" data-field="message">
          <label for="sc-message">Tell Us About Your Project *</label>
          <textarea id="sc-message" placeholder="Describe your project, location, timeline and any relevant details…"></textarea>
        </div>
        <button type="submit" class="cform-submit" id="sc-submit">Send Message →</button>
      </form>
    </div>
  </div>

  <div class="contact-info-bar">
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-solid fa-phone"></i></div>
      <div class="cinfo-label">Phone</div>
      <div class="cinfo-value"><a href={phoneHref}>{site.phone}</a></div>
      <div class="cinfo-note">{site.phoneHours}</div>
    </div>
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-solid fa-envelope"></i></div>
      <div class="cinfo-label">Email</div>
      <div class="cinfo-value"><a href={`mailto:${site.email}`}>{site.email}</a></div>
      <div class="cinfo-note">{site.emailNote}</div>
    </div>
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-brands fa-whatsapp"></i></div>
      <div class="cinfo-label">WhatsApp</div>
      <div class="cinfo-value"><a href={waHref}>{site.whatsapp}</a></div>
      <div class="cinfo-note">{site.whatsappNote}</div>
    </div>
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-solid fa-location-dot"></i></div>
      <div class="cinfo-label">Service Area</div>
      <div class="cinfo-value">{site.serviceArea}</div>
      <div class="cinfo-note">{site.serviceAreaNote}</div>
    </div>
  </div>
</section>

<script>
  import { applyFieldErrors, validateContactFields } from '../utils/formValidation'

  const scForm = document.getElementById('section-contact-form') as HTMLFormElement | null
  const scSubmit = document.getElementById('sc-submit') as HTMLButtonElement | null
  const scSuccess = document.getElementById('sc-success') as HTMLElement | null

  scForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const firstName = (document.getElementById('sc-first-name') as HTMLInputElement)?.value ?? ''
    const lastName = (document.getElementById('sc-last-name') as HTMLInputElement)?.value ?? ''
    const email = (document.getElementById('sc-email') as HTMLInputElement)?.value ?? ''
    const phone = (document.getElementById('sc-phone') as HTMLInputElement)?.value ?? ''
    const service = (document.getElementById('sc-service') as HTMLSelectElement)?.value
    const message = (document.getElementById('sc-message') as HTMLTextAreaElement)?.value ?? ''

    const errors = validateContactFields({ firstName, email, phone, message })
    const valid = applyFieldErrors(
      {
        firstName: scForm?.querySelector('[data-field="firstName"]') as HTMLElement,
        email: scForm?.querySelector('[data-field="email"]') as HTMLElement,
        phone: scForm?.querySelector('[data-field="phone"]') as HTMLElement,
        message: scForm?.querySelector('[data-field="message"]') as HTMLElement,
      },
      errors,
    )
    if (!valid) return

    if (scSubmit) { scSubmit.disabled = true; scSubmit.textContent = 'Sending…' }

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          formType: 'request-consultation',
          Name: `${firstName.trim()} ${lastName.trim()}`.trim(),
          Email: email.trim(),
          Phone: phone.trim(),
          Service: service,
          Message: message.trim(),
        }),
      })
      const data = await res.json()
      if (data.ok) {
        scForm.style.display = 'none'
        if (scSuccess) scSuccess.style.display = 'block'
      } else {
        if (scSubmit) { scSubmit.disabled = false; scSubmit.textContent = 'Send Message →' }
        alert('Something went wrong. Please try again.')
      }
    } catch {
      if (scSubmit) { scSubmit.disabled = false; scSubmit.textContent = 'Send Message →' }
      alert('Something went wrong. Please try again.')
    }
  })
</script>
