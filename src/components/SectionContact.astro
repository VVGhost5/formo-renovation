---
---
<section id="contact">
  <div class="contact-top">
    <!-- Left: photo with text overlay -->
    <div class="contact-photo-side">
      <img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1000&q=85" alt="Contact Formo Renovations" loading="lazy" />
      <div class="contact-photo-overlay"></div>
      <div class="contact-photo-content">
        <div class="contact-eyebrow">Contact Us</div>
        <h2 class="contact-headline">
          Let's Start<br>Your <em>Project</em>
        </h2>
        <p class="contact-lead">
          Whether you're ready to begin or just exploring options — reach out. No pressure, just an honest conversation about what you need and how we can help.
        </p>
        <button class="btn-outline-light">Book a Free Consultation →</button>
      </div>
    </div>

    <!-- Right: form -->
    <div class="contact-form-side">
      <div class="contact-form-title">Send Us a Message</div>
      <div class="contact-form-sub">We'll get back to you within one business day.</div>

      <div class="cform">
        <div class="cform-row">
          <div class="fg">
            <label>First Name</label>
            <input type="text" placeholder="John" />
          </div>
          <div class="fg">
            <label>Last Name</label>
            <input type="text" placeholder="Smith" />
          </div>
        </div>
        <div class="fg">
          <label>Email</label>
          <input type="email" placeholder="john@email.com" />
        </div>
        <div class="fg">
          <label>Phone</label>
          <input type="tel" placeholder="+1 (250) 000-0000" />
        </div>
        <div class="fg">
          <label>Service Interested In</label>
          <select>
            <option value="">Select a service…</option>
            <option>Interior Finishing</option>
            <option>Bathroom Renovations</option>
            <option>Kitchen Renovations</option>
            <option>Flooring</option>
            <option>Painting</option>
            <option>Project Management</option>
            <option>Free Estimate Only</option>
          </select>
        </div>
        <div class="fg">
          <label>Tell Us About Your Project</label>
          <textarea placeholder="Describe your project, location, timeline and any relevant details…"></textarea>
        </div>
        <button class="cform-submit">Send Message →</button>
      </div>
    </div>
  </div>

  <!-- Contact info bar -->
  <div class="contact-info-bar">
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-solid fa-phone"></i></div>
      <div class="cinfo-label">Phone</div>
      <div class="cinfo-value"><a href="tel:+12500000000">+1 (250) 000-0000</a></div>
      <div class="cinfo-note">Mon – Fri, 8:00 AM – 6:00 PM</div>
    </div>
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-solid fa-envelope"></i></div>
      <div class="cinfo-label">Email</div>
      <div class="cinfo-value"><a href="mailto:hello@formorenovations.ca">hello@formorenovations.ca</a></div>
      <div class="cinfo-note">Response within 1 business day</div>
    </div>
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-brands fa-whatsapp"></i></div>
      <div class="cinfo-label">WhatsApp</div>
      <div class="cinfo-value"><a href="https://wa.me/12500000000">+1 (250) 000-0000</a></div>
      <div class="cinfo-note">Quick questions &amp; project photos</div>
    </div>
    <div class="cinfo-card">
      <div class="cinfo-icon"><i class="fa-solid fa-location-dot"></i></div>
      <div class="cinfo-label">Service Area</div>
      <div class="cinfo-value">Victoria &amp; Vancouver Island</div>
      <div class="cinfo-note">BC, Canada</div>
    </div>
  </div>
</section>
