---
import type {HomeServicesContent} from '../utils/sanity'

interface Props {
	content: HomeServicesContent
}

const {content} = Astro.props
---
<section id="services">
  <div class="services-head">
    <div class="services-eyebrow">{content.eyebrow}</div>
    <h2 class="services-title">
      {content.title}<br />
      <span>{content.titleAccent}</span>
    </h2>
  </div>

  <div class="services-row">
    {content.cards.map((s) => (
      <a class="svc-card" href={s.link || '/services'} aria-label={s.name}>
        <img src={s.imageUrl} alt={s.name} loading="lazy" />
        <div class="svc-card-body">
          <div class="svc-card-label">
            <span class="svc-card-name">{s.name}</span>
            <span class="svc-card-arr">→</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
