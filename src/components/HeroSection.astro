---
import {urlForImage, type HeroDoc} from '../utils/sanity'

interface Props {
	hero: HeroDoc
}

const {hero} = Astro.props

const bgUrl = hero ? urlForImage(hero.backgroundImage ?? undefined) : null
const hasCta = Boolean(hero?.ctaLabel && hero?.ctaLink)
---

<section class="hero" style={bgUrl ? `--hero-bg: url(${bgUrl})` : undefined}>
	<div class="hero__inner">
		{
			hero?.title ? (
				<>
					<h1 class="hero__title">{hero.title}</h1>
					{hero.subtitle ? <p class="hero__subtitle">{hero.subtitle}</p> : null}
					{hasCta ? (
						<a class="hero__cta" href={hero.ctaLink!}>
							{hero.ctaLabel}
						</a>
					) : null}
				</>
			) : (
				<div class="hero__empty">
					<p class="hero__empty-title">No hero content yet</p>
					<p class="hero__empty-text">
						Create a <strong>Hero</strong> document in Sanity Studio and publish it to show it
						here.
					</p>
				</div>
			)
		}
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: min(70vh, 520px);
		display: flex;
		align-items: flex-end;
		padding: clamp(1.5rem, 4vw, 3rem);
		background-color: #1c1917;
		background-image: linear-gradient(
				to top,
				rgb(28 25 23 / 0.92) 0%,
				rgb(28 25 23 / 0.45) 55%,
				rgb(28 25 23 / 0.25) 100%
			),
			var(--hero-bg);
		background-size: cover;
		background-position: center;
		color: #fafaf9;
	}

	.hero:not([style*='--hero-bg']) {
		background-image: linear-gradient(145deg, #292524 0%, #1c1917 50%, #0c0a09 100%);
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		max-width: 40rem;
	}

	.hero__title {
		margin: 0 0 0.75rem;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.hero__subtitle {
		margin: 0 0 1.25rem;
		font-size: 1.05rem;
		line-height: 1.55;
		color: #e7e5e4;
		max-width: 36ch;
	}

	.hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1.25rem;
		font-size: 0.95rem;
		font-weight: 600;
		color: #1c1917;
		background: #f5f5f4;
		border-radius: 0.5rem;
		text-decoration: none;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}

	.hero__cta:hover {
		background: #fff;
		transform: translateY(-1px);
	}

	.hero__empty {
		padding: 0.25rem 0;
	}

	.hero__empty-title {
		margin: 0 0 0.5rem;
		font-size: 1.25rem;
		font-weight: 600;
	}

	.hero__empty-text {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: #d6d3d1;
		max-width: 32ch;
	}
</style>
