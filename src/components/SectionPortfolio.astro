---
import type {HomePortfolioContent} from '../utils/sanity'
import {bgStyle} from '../utils/sanity/backgrounds'

interface Props {
	content: HomePortfolioContent
}

const {content} = Astro.props
const heroBg = bgStyle(content.heroImageUrl)
---
<section id="portfolio">
  <div class="portfolio-hero">
    <div class="portfolio-hero-img" style={heroBg}></div>
    <div class="portfolio-hero-content">
      <div class="portfolio-eyebrow">{content.eyebrow}</div>
      <h2 class="portfolio-headline">
        {content.headline}<br />
        <em>{content.headlineEmphasis}</em>
      </h2>
      <p class="portfolio-desc">{content.description}</p>
      <a href={content.ctaLink} class="btn-outline-light">{content.ctaLabel}</a>
    </div>
  </div>

  <div class="portfolio-grid">
    {content.projects.map((p) => (
      <a class="port-card" href="/portfolio/" aria-label={`View portfolio: ${p.title}`}>
        <span class="port-tag">{p.tag}</span>
        {p.imageUrl && (
          <img width="420" height="300" src={p.imageUrl} alt={p.title} loading="lazy" />
        )}
        <div class="port-card-body">
          <div class="port-card-title">{p.title}</div>
          <div class="port-card-meta">{p.meta}</div>
        </div>
        <div class="port-card-arr">→</div>
      </a>
    ))}
  </div>
</section>
