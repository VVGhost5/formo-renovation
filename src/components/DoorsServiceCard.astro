---
import {doorCardImage} from '../utils/doorsImages'

interface Props {
	title: string
	description: string
	imageKey: string
	index: number
	category: string
}

const {title, description, imageKey, index, category} = Astro.props
const image = doorCardImage(imageKey)
const number = String(index + 1).padStart(2, '0')
---

<article class="doors-card">
  {image && (
    <figure class="doors-card-figure">
      <img class="doors-card-photo" src={image.src} alt={image.alt} width="1024" height="768" loading="lazy" decoding="async" />
    </figure>
  )}
  <div class="doors-card-body">
    <span class="doors-card-num" aria-hidden="true">{category} · {number}</span>
    <h3>{title}</h3>
    <p>{description}</p>
    <a
      class="btn-outline doors-quote"
      href="#estimate"
      data-door-service={title}
      aria-label={`Get a free quote for ${title.toLowerCase()}`}
    >
      Get a Free Quote<span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
