---
import logoIcon from '../assets/images/header-icon.svg'
import type {SiteSettingsContent} from '../utils/sanity'
import {DEFAULT_SITE_SETTINGS} from '../utils/sanity'

interface Props {
	site?: SiteSettingsContent
}

const {site = DEFAULT_SITE_SETTINGS} = Astro.props
const phoneHref = `tel:${site.phone.replace(/\D/g, '')}`
const socialUrl = (url?: string) => {
	const value = url?.trim()
	return value && value !== '#' ? value : ''
}
const socials = [
	{href: socialUrl(site.instagramUrl), title: 'Instagram', icon: 'fa-brands fa-instagram'},
	{href: socialUrl(site.facebookUrl), title: 'Facebook', icon: 'fa-brands fa-facebook-f'},
	{href: socialUrl(site.houzzUrl), title: 'Houzz', icon: 'fa-brands fa-houzz'},
	{href: socialUrl(site.homestarsUrl), title: 'HomeStars', icon: 'fa-solid fa-star'},
].filter((item) => item.href)
---
<footer>
  <div class="footer-main">

    <div class="footer-brand">
      <a class="footer-logo" href="/">
        <img width="120" height="120" src={logoIcon.src} alt="Formo Renovations" class="footer-logo-img" />
      </a>
      <p>{site.footerDescription}</p>
      {socials.length > 0 && (
        <div class="footer-socials">
          {socials.map((item) => (
            <a class="social-btn" href={item.href} title={item.title} aria-label={item.title}>
              <i class={item.icon}></i>
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="footer-col">
      <h3>Navigation</h3>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/portfolio/">Portfolio</a></li>
        <li><a href="/services/">Services</a></li>
        <li><a href="/about-us/">About</a></li>
        <li><a href="/contacts/">Contact</a></li>
        <li><a href="/sitemap/">Sitemap</a></li>
      </ul>
    </div>

    <div class="footer-contact">
      <h3>Contact Us</h3>
      <div class="footer-contact-items">
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-solid fa-phone"></i></span>
          <div class="fc-text">
            <a href={phoneHref}>{site.phone}</a>
          </div>
        </div>
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-solid fa-envelope"></i></span>
          <div class="fc-text">
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-solid fa-location-dot"></i></span>
          <div class="fc-text">{site.serviceArea}, {site.serviceAreaNote}</div>
        </div>
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-regular fa-clock"></i></span>
          <div class="fc-text">{site.phoneHours}</div>
        </div>
      </div>
    </div>

  </div>

  <div class="footer-sub">
    <p>© 2026 Formo Renovations. All rights reserved.</p>
    <a href="/privacy/">Privacy Policy</a>
  </div>
</footer>
