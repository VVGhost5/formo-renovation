---
import logoWhite from '../assets/images/formo-logo-white.svg'
import type {SiteSettingsContent} from '../utils/sanity'
import {DEFAULT_SITE_SETTINGS} from '../utils/sanity'

interface Props {
	site?: SiteSettingsContent
}

const {site = DEFAULT_SITE_SETTINGS} = Astro.props
const phoneHref = `tel:${site.phone.replace(/\D/g, '')}`
---
<footer>
  <div class="footer-main">

    <div class="footer-brand">
      <a class="footer-logo" href="/">
        <img src={logoWhite.src} alt="Formo Renovations" class="footer-logo-img" />
      </a>
      <p>{site.footerDescription}</p>
      <div class="footer-socials">
        <a class="social-btn" href={site.instagramUrl} title="Instagram" aria-label="Instagram">
          <i class="fa-brands fa-instagram"></i>
        </a>
        <a class="social-btn" href={site.facebookUrl} title="Facebook" aria-label="Facebook">
          <i class="fa-brands fa-facebook-f"></i>
        </a>
        <a class="social-btn" href={site.houzzUrl} title="Houzz" aria-label="Houzz">
          <i class="fa-brands fa-houzz"></i>
        </a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Navigation</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/about-us">About</a></li>
        <li><a href="/contacts">Contact</a></li>
      </ul>
    </div>

    <div class="footer-contact">
      <h4>Contact Us</h4>
      <div class="footer-contact-items">
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-solid fa-phone"></i></span>
          <div class="fc-text">
            <a href={phoneHref}>{site.phone}</a>
          </div>
        </div>
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-solid fa-envelope"></i></span>
          <div class="fc-text">
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-solid fa-location-dot"></i></span>
          <div class="fc-text">{site.serviceArea}, {site.serviceAreaNote}</div>
        </div>
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-regular fa-clock"></i></span>
          <div class="fc-text">{site.phoneHours}</div>
        </div>
      </div>
    </div>

  </div>

  <div class="footer-sub">
    <p>© 2025 Formo Renovations. All rights reserved.</p>
    <div class="footer-sub-links">
      <a href="#">Privacy Policy</a>
      <a href="#">Terms of Service</a>
      <a href="#">Sitemap</a>
    </div>
  </div>
</footer>
