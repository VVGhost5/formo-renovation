---
import logoWhite from '../assets/images/formo-logo-white.svg'
---
<footer>
  <div class="footer-main">

    <div class="footer-brand">
      <a class="footer-logo" href="/">
        <img src={logoWhite.src} alt="Formo Renovations" class="footer-logo-img" />
      </a>
      <p>Premium renovation and interior finishing solutions for homes across Victoria and Vancouver Island, BC. European standards. Transparent process.</p>
      <div class="footer-socials">
        <a class="social-btn" href="#" title="Instagram" aria-label="Instagram">
          <i class="fa-brands fa-instagram"></i>
        </a>
        <a class="social-btn" href="#" title="Facebook" aria-label="Facebook">
          <i class="fa-brands fa-facebook-f"></i>
        </a>
        <a class="social-btn" href="#" title="Houzz" aria-label="Houzz">
          <i class="fa-brands fa-houzz"></i>
        </a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Navigation</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/about-us">About</a></li>
        <li><a href="/contacts">Contact</a></li>
      </ul>
    </div>

    <div class="footer-contact">
      <h4>Contact Us</h4>
      <div class="footer-contact-items">
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-solid fa-phone"></i></span>
          <div class="fc-text">
            <a href="tel:+12500000000">+1 (250) 000-0000</a>
          </div>
        </div>
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-solid fa-envelope"></i></span>
          <div class="fc-text">
            <a href="mailto:hello@formorenovations.ca">hello@formorenovations.ca</a>
          </div>
        </div>
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-solid fa-location-dot"></i></span>
          <div class="fc-text">Victoria &amp; Vancouver Island, BC, Canada</div>
        </div>
        <div class="fc-item">
          <span class="fc-icon"><i class="fa-regular fa-clock"></i></span>
          <div class="fc-text">Mon – Fri: 8:00 AM – 6:00 PM</div>
        </div>
      </div>
    </div>

  </div>

  <div class="footer-sub">
    <p>© 2025 Formo Renovations. All rights reserved.</p>
    <div class="footer-sub-links">
      <a href="#">Privacy Policy</a>
      <a href="#">Terms of Service</a>
      <a href="#">Sitemap</a>
    </div>
  </div>
</footer>
