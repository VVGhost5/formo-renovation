---
import type {HomeAboutContent} from '../utils/sanity'
import {bgStyle} from '../utils/sanity/backgrounds'

interface Props {
	content: HomeAboutContent
}

const {content} = Astro.props
const heroBg = bgStyle(content.heroImageUrl)
---
<section id="about">
  <div class="about-hero">
    <div class="about-hero-img" style={heroBg}></div>
    <div class="about-hero-content">
      <div class="about-eyebrow">{content.eyebrow}</div>
      <h2 class="about-headline">
        {content.headline}
        <em>{content.headlineEmphasis}</em>
      </h2>
      <p class="about-hero-desc">{content.heroDescription}</p>
      <a href={content.heroCtaLink} class="btn-outline-light">{content.heroCtaLabel}</a>
    </div>
  </div>

  <div class="about-rows">
    {content.rows.map((row) => (
      <div class={`about-row${row.reverse ? ' reverse' : ''}`}>
        <div class="about-row-text">
          <div class="about-row-label">{row.label}</div>
          <h3 class="about-row-h3">{row.headingBefore}<em>{row.headingEmphasis}</em></h3>
          {row.paragraphs.map((p) => <p class="about-row-p">{p}</p>)}
          <div class="about-pills">
            {row.pills.map((pill) => <span class="about-pill">{pill}</span>)}
          </div>
        </div>
        <div class="about-row-img">
          <img src={row.imageUrl} alt={row.imageAlt} loading="lazy" />
        </div>
      </div>
    ))}
  </div>
</section>
