---
interface BreadcrumbItem {
	label: string
	href?: string
}

interface Props {
	items: BreadcrumbItem[]
}

const { items } = Astro.props
---

<nav class="bc-nav" aria-label="Breadcrumb">
  <ol class="bc-list">
    <li class="bc-item">
      <a href="/" class="bc-link">Home</a>
      <span class="bc-sep" aria-hidden="true">/</span>
    </li>
    {items.map((item, i) => (
      <li class="bc-item">
        {item.href ? (
          <a href={item.href} class="bc-link">{item.label}</a>
        ) : (
          <span class="bc-current" aria-current="page">{item.label}</span>
        )}
        {i < items.length - 1 && <span class="bc-sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style lang="scss">
  .bc-nav {
    /* Absolute positioning — sits 20px below the fixed 60px nav */
    position: absolute;
    top: 80px; /* 60px nav + 20px gap */
    left: var(--px);
    z-index: 3;
    background: transparent;
    pointer-events: auto;
  }

  .bc-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .bc-item {
    display: flex;
    align-items: center;
  }

  .bc-sep {
    margin: 0 7px;
    color: rgba(255, 255, 255, 0.3);
  }

  .bc-link {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.2s;

    &:hover {
      color: rgba(255, 255, 255, 0.88);
    }
  }

  .bc-current {
    color: rgba(255, 255, 255, 0.82);
  }

  /* Mobile: nav shrinks to 54px */
  @media (max-width: 767px) {
    .bc-nav {
      top: 74px; /* 54px nav + 20px gap */
    }

    .bc-list {
      font-size: 10px;
    }
  }
</style>
