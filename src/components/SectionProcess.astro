---
import type {HomeProcessContent} from '../utils/sanity'
import {bgStyle} from '../utils/sanity/backgrounds'

interface Props {
	content: HomeProcessContent
}

const {content} = Astro.props
const heroBg = bgStyle(content.heroImageUrl)
---
<section id="process">
  <div class="process-hero">
    <div class="process-hero-img" style={heroBg}></div>
    <div class="process-hero-content">
      <div class="process-eyebrow">{content.eyebrow}</div>
      <h2 class="process-headline">
        {content.headline}<br />
        <em>{content.headlineEmphasis}</em>
      </h2>
      <p class="process-desc">{content.description}</p>
      <button class="btn-outline-light" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">
        {content.ctaLabel}
      </button>
    </div>
  </div>

  <div class="process-grid">
    {content.steps.map((s, i) => (
      <div class="pstep-card">
        <div class="pstep-big-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
        <div class="pstep-title">{s.title}</div>
        <div class="pstep-desc">{s.description}</div>
        <div class="pstep-arrow" aria-hidden="true">{i === content.steps.length - 1 ? '✓' : '→'}</div>
      </div>
    ))}
  </div>
</section>
