---
import type {HomeNumbersContent} from '../utils/sanity'

interface Props {
	content: HomeNumbersContent
}

const {content} = Astro.props
---
<section id="trust-numbers">
  <div class="numbers-inner">
    <div class="numbers-left">
      <div class="numbers-eyebrow">{content.eyebrow}</div>
      <h2 class="numbers-headline">{content.headline}</h2>
    </div>

    <div class="numbers-stats">
      {content.stats.map((stat) => (
        <div class="stat-item">
          <div class="stat-val">
            {stat.value}{stat.suffix ? <sup>{stat.suffix}</sup> : null}
          </div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
