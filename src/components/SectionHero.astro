---
import type {HeroContent} from '../utils/sanity'
import {bgStyle} from '../utils/sanity/backgrounds'

interface Props {
	hero: HeroContent
}

const {hero} = Astro.props
const bgStyleAttr = bgStyle(hero.backgroundImageUrl)
---

<section id="hero">
  <div
    class="hero-bg-img"
    style={bgStyleAttr}
    role="img"
    aria-label={hero.backgroundImageAlt ?? undefined}
  ></div>

  <div class="hero-left">
    <div class="hero-location">
      <span class="hero-location-dot"></span>
      {hero.locationLabel}
    </div>

    <h1 class="hero-h1">
      {hero.titleLine1}<br />{hero.titleLine2}
    </h1>
    <div class="hero-h1-sub">{hero.titleSub}</div>

    <hr class="hero-line" />

    <p class="hero-desc">{hero.description}</p>

    <div class="hero-actions">
      <button
        class="btn-outline"
        onclick="document.getElementById('portfolio').scrollIntoView({behavior:'smooth'})"
      >
        {hero.secondaryCtaLabel}
      </button>
    </div>
  </div>

  <div class="hero-right">
    <div class="hero-form-overlay">
      <div class="hfo-title">{hero.formTitle}</div>
      <div class="hfo-sub">{hero.formSubtext}</div>
      <form id="hero-form" class="hfo-fields" novalidate>
        <input type="hidden" name="formType" value="request-call" />
        <input id="hf-name" name="Name" type="text" placeholder="Your Name" required />
        <input id="hf-phone" name="Phone" type="tel" placeholder="Phone Number" />
        <input id="hf-email" name="Email" type="email" placeholder="Email Address" required />
        <button type="submit" class="hfo-submit" id="hf-submit">Send Message →</button>
      </form>
      <div class="hfo-success" id="hf-success" style="display:none;text-align:center;padding:12px 0;color:#c8a96e;font-weight:600;">
        ✓ Sent! We'll be in touch soon.
      </div>
      <div class="hfo-note">{hero.formNote}</div>
    </div>
  </div>
</section>

<script>
  const heroForm = document.getElementById('hero-form') as HTMLFormElement | null
  const hfSubmit = document.getElementById('hf-submit') as HTMLButtonElement | null
  const hfSuccess = document.getElementById('hf-success') as HTMLElement | null

  heroForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const name = (document.getElementById('hf-name') as HTMLInputElement)?.value.trim()
    const phone = (document.getElementById('hf-phone') as HTMLInputElement)?.value.trim()
    const email = (document.getElementById('hf-email') as HTMLInputElement)?.value.trim()
    if (!name || !email) return

    if (hfSubmit) { hfSubmit.disabled = true; hfSubmit.textContent = 'Sending…' }

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ formType: 'request-call', Name: name, Phone: phone, 'Email Address': email }),
      })
      const data = await res.json()
      if (data.ok) {
        heroForm.style.display = 'none'
        if (hfSuccess) hfSuccess.style.display = 'block'
      } else {
        if (hfSubmit) { hfSubmit.disabled = false; hfSubmit.textContent = 'Send Message →' }
        alert('Something went wrong. Please try again.')
      }
    } catch {
      if (hfSubmit) { hfSubmit.disabled = false; hfSubmit.textContent = 'Send Message →' }
      alert('Something went wrong. Please try again.')
    }
  })
</script>
