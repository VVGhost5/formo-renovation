---
import type {HeroContent} from '../utils/sanity'

interface Props {
	hero: HeroContent
}

const {hero} = Astro.props
const bgStyle = hero.backgroundImageUrl
	? `background-image: url(${hero.backgroundImageUrl})`
	: undefined
---

<section id="hero">
  <div
    class="hero-bg-img"
    style={bgStyle}
    role={hero.backgroundImageUrl ? 'img' : undefined}
    aria-label={hero.backgroundImageAlt ?? undefined}
  ></div>

  <div class="hero-left">
    <div class="hero-location">
      <span class="hero-location-dot"></span>
      {hero.locationLabel}
    </div>

    <h1 class="hero-h1">
      {hero.titleLine1}<br />{hero.titleLine2}
    </h1>
    <div class="hero-h1-sub">{hero.titleSub}</div>

    <hr class="hero-line" />

    <p class="hero-desc">{hero.description}</p>

    <div class="hero-actions">
      <button
        class="btn-dark"
        onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})"
      >
        {hero.primaryCtaLabel}
      </button>
      <button
        class="btn-outline"
        onclick="document.getElementById('portfolio').scrollIntoView({behavior:'smooth'})"
      >
        {hero.secondaryCtaLabel}
      </button>
    </div>
  </div>

  <div class="hero-right">
    <div class="hero-form-overlay">
      <div class="hfo-title">{hero.formTitle}</div>
      <div class="hfo-sub">{hero.formSubtext}</div>
      <div class="hfo-fields">
        <input type="text" placeholder="Your Name" />
        <input type="tel" placeholder="Phone Number" />
        <input type="email" placeholder="Email Address" />
        <button class="hfo-submit">{hero.primaryCtaLabel}</button>
      </div>
      <div class="hfo-note">{hero.formNote}</div>
    </div>
  </div>
</section>
