---
import type {HeroContent} from '../utils/sanity'
import {bgStyle} from '../utils/sanity/backgrounds'

interface Props {
	hero: HeroContent
}

const {hero} = Astro.props
const bgStyleAttr = bgStyle(hero.backgroundImageUrl)
---

<section id="hero">
  {bgStyleAttr && (
    <div
      class="hero-bg-img"
      style={bgStyleAttr}
      aria-hidden="true"
    ></div>
  )}

  <div class="hero-left">
    {hero.locationLabel && (
      <div class="hero-location">
        <span class="hero-location-dot"></span>
        {hero.locationLabel}
      </div>
    )}

    {hero.titleLine1 && <h1 class="hero-h1">{hero.titleLine1}</h1>}

    {(hero.titleLine1 || hero.description) && <hr class="hero-line" />}

    {hero.description && <p class="hero-desc">{hero.description}</p>}

    {hero.secondaryCtaLabel && (
      <div class="hero-actions">
        <button
          class="btn-outline"
          onclick="document.getElementById('portfolio').scrollIntoView({behavior:'smooth'})"
        >
          {hero.secondaryCtaLabel}
        </button>
      </div>
    )}
  </div>

  <div class="hero-right">
    <div class="hero-form-overlay">
      {hero.formTitle && <div class="hfo-title">{hero.formTitle}</div>}
      {hero.formSubtext && <div class="hfo-sub">{hero.formSubtext}</div>}
      <form id="hero-form" class="hfo-fields" novalidate>
        <input type="hidden" name="formType" value="request-call" />
        <div class="hfo-fg" data-field="name">
          <input id="hf-name" name="Name" type="text" placeholder="Your Name *" autocomplete="name" />
        </div>
        <div class="hfo-fg" data-field="phone">
          <input id="hf-phone" name="Phone" type="tel" data-phone-mask placeholder="+1 (250) 000-0000 *" autocomplete="tel" />
        </div>
        <div class="hfo-fg" data-field="email">
          <input id="hf-email" name="Email" type="email" placeholder="Email Address *" autocomplete="email" />
        </div>
        <button type="submit" class="hfo-submit" id="hf-submit">Send Message →</button>
      </form>
      <div class="hfo-success" id="hf-success" style="display:none;text-align:center;padding:12px 0;color:#c8a96e;font-weight:600;">
        ✓ Sent! We'll be in touch soon.
      </div>
      {hero.formNote && <div class="hfo-note">{hero.formNote}</div>}
    </div>
  </div>
</section>

<script>
  import {
    applyFieldErrors,
    validateEstimateFields,
  } from '../utils/formValidation'
  import { initPhoneMasks } from '../utils/phoneMask'

  const heroForm = document.getElementById('hero-form') as HTMLFormElement | null
  const hfSubmit = document.getElementById('hf-submit') as HTMLButtonElement | null
  const hfSuccess = document.getElementById('hf-success') as HTMLElement | null

  if (heroForm) initPhoneMasks(heroForm)

  heroForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const name = (document.getElementById('hf-name') as HTMLInputElement)?.value ?? ''
    const phone = (document.getElementById('hf-phone') as HTMLInputElement)?.value ?? ''
    const email = (document.getElementById('hf-email') as HTMLInputElement)?.value ?? ''

    const errors = validateEstimateFields({ name, phone, email })
    const valid = applyFieldErrors(
      {
        name: heroForm?.querySelector('[data-field="name"]') as HTMLElement,
        phone: heroForm?.querySelector('[data-field="phone"]') as HTMLElement,
        email: heroForm?.querySelector('[data-field="email"]') as HTMLElement,
      },
      errors,
    )
    if (!valid) return

    if (hfSubmit) { hfSubmit.disabled = true; hfSubmit.textContent = 'Sending…' }

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          formType: 'request-call',
          Name: name.trim(),
          Phone: phone.trim(),
          'Email Address': email.trim(),
        }),
      })
      const data = await res.json()
      if (data.ok) {
        heroForm.style.display = 'none'
        if (hfSuccess) hfSuccess.style.display = 'block'
      } else {
        if (hfSubmit) { hfSubmit.disabled = false; hfSubmit.textContent = 'Send Message →' }
        alert('Something went wrong. Please try again.')
      }
    } catch {
      if (hfSubmit) { hfSubmit.disabled = false; hfSubmit.textContent = 'Send Message →' }
      alert('Something went wrong. Please try again.')
    }
  })
</script>
