---
---
<section id="hero">
  <div class="hero-bg-img"></div>

  <div class="hero-left">
    <div class="hero-location">
      <span class="hero-location-dot"></span>
      Victoria &amp; Vancouver Island
    </div>

    <h1 class="hero-h1">Premium<br>Renovations</h1>
    <div class="hero-h1-sub">&amp; Interior Finishing</div>

    <hr class="hero-line" />

    <p class="hero-desc">
      We deliver premium renovation and interior finishing solutions that combine craftsmanship,
      transparent communication, and meticulous quality control — from concept to completion.
    </p>

    <div class="hero-actions">
      <button class="btn-dark" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">Get a Free Estimate →</button>
      <button class="btn-outline" onclick="document.getElementById('portfolio').scrollIntoView({behavior:'smooth'})">View Our Projects →</button>
    </div>
  </div>

  <div class="hero-right">
    <div class="hero-form-overlay">
      <div class="hfo-title">Request a Free Estimate</div>
      <div class="hfo-sub">We'll call you back within one business day</div>
      <div class="hfo-fields">
        <input type="text"  placeholder="Your Name" />
        <input type="tel"   placeholder="Phone Number" />
        <input type="email" placeholder="Email Address" />
        <button class="hfo-submit">Get a Free Estimate →</button>
      </div>
      <div class="hfo-note">No commitment — just an honest conversation</div>
    </div>
  </div>
</section>
