---
import type {HomePricingContent} from '../utils/sanity'

interface Props {
	content: HomePricingContent
}

const {content} = Astro.props
const heroBg = content.heroImageUrl ? `background-image: url(${content.heroImageUrl})` : undefined
---
<section id="pricing">
  <div class="pricing-hero">
    <div class="pricing-hero-img" style={heroBg}></div>
    <div class="pricing-hero-content">
      <div class="pricing-eyebrow">{content.eyebrow}</div>
      <h2 class="pricing-headline">
        {content.headline}
        <em>{content.headlineEmphasis}</em>
      </h2>
      <p class="pricing-hero-desc">{content.heroDescription}</p>
      <button class="btn-outline-light" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">
        {content.heroCtaLabel}
      </button>
    </div>
  </div>

  <div class="pricing-content">
    <div class="pricing-intro-text">
      <h3>{content.introTitle}</h3>
      <p>{content.introText}</p>
    </div>

    <div class="pricing-grid">
      {content.factors.map((f) => (
        <div class="pfactor-card">
          <div class="pfactor-num">{f.num}</div>
          <div class="pfactor-body">
            <div class="pfactor-title">{f.title}</div>
            <div class="pfactor-desc">{f.description}</div>
          </div>
        </div>
      ))}
    </div>

    <div class="pricing-cta-band">
      <div class="pricing-cta-left">
        <div class="pricing-cta-label">{content.ctaLabel}</div>
        <div class="pricing-cta-title">{content.ctaTitle}</div>
        <p class="pricing-cta-sub">{content.ctaSubtext}</p>
      </div>
      <div class="pricing-cta-right">
        <button class="btn-dark" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">
          {content.ctaPrimaryLabel}
        </button>
        <button class="btn-outline" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">
          {content.ctaSecondaryLabel}
        </button>
      </div>
    </div>
  </div>
</section>
